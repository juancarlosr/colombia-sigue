# Local dev database (docker compose up -d db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/colombia_sigue?schema=public"

# Session signing secret, min 32 chars (openssl rand -base64 48)
SESSION_SECRET=""

# Base URL used to build magic links
APP_URL="http://localhost:3000"

# Optional: without RESEND_API_KEY, magic links are logged to the server console
# RESEND_API_KEY=""
# EMAIL_FROM="Colombia Sigue <no-reply@yourdomain.com>"
